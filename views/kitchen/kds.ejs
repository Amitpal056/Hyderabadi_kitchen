<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KDS Terminal - <%= outlet.name %></title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="/socket.io/socket.io.js"></script>
    <style>
        @keyframes pulseZoom {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.04); }
        }
        .animate-zoom {
            animation: pulseZoom 1s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-stone-950 text-stone-100 p-8 font-sans antialiased min-h-screen">
    <%- include('../partials/nav') %>

    <!-- Header -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center my-8 pb-6 border-b border-stone-800 gap-4">
        <div>
            <span class="text-xs font-bold uppercase tracking-widest text-amber-500">Live Kitchen Terminal</span>
            <h1 class="text-4xl font-black tracking-tight text-stone-100 mt-1"><%= outlet.name %></h1>
        </div>
        <div class="flex items-center gap-4">
            <a href="/kitchen/<%= outlet.id %>/history" target="_blank" class="bg-stone-900 hover:bg-stone-800 border border-stone-800 text-stone-300 font-bold text-xs uppercase px-5 py-3 rounded-2xl transition flex items-center gap-2 shadow cursor-pointer">
                📂 Open History Log (New Tab)
            </a>
            <div class="bg-stone-900 border border-stone-800 px-6 py-3 rounded-2xl">
                <span class="text-xs text-stone-400 uppercase font-bold block">Active Tickets</span>
                <span id="ticket-count" class="font-black text-amber-400 text-2xl font-mono"><%= outletActiveOrders.length %></span>
            </div>
        </div>
    </header>

    <% const delayedOrders = outletActiveOrders.filter(order => order.status === 'Delayed / Manager Alert'); %>
    <% if (delayedOrders.length > 0) { %>
        <section class="mb-8 rounded-2xl border border-rose-700 bg-rose-950/60 p-5 text-rose-100" role="alert">
            <h2 class="font-extrabold">Manager alert: delayed orders (<%= delayedOrders.length %>)</h2>
            <ul class="mt-2 space-y-1 text-sm">
                <% delayedOrders.forEach(order => { %>
                    <li><strong><%= order.id %></strong> is more than 10 minutes past its promised time. Please review and contact the customer.</li>
                <% }) %>
            </ul>
        </section>
    <% } %>

    <!-- Active Prep Queue -->
    <div class="space-y-6">
        <h2 class="text-lg font-extrabold uppercase tracking-wider text-stone-400 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-ping"></span> Active Prep Queue (45 Min SLA)
        </h2>

        <% if (outletActiveOrders.length === 0) { %>
            <div class="bg-stone-900 border border-stone-800 rounded-3xl p-16 text-center text-stone-500 max-w-xl mx-auto">
                <p class="text-2xl font-extrabold text-stone-400 mb-1">Kitchen Clear</p>
                <p class="text-sm">Awaiting new direct orders from customers...</p>
            </div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="kds-board">
            <% outletActiveOrders.forEach(order => { %>
                <div class="bg-stone-900 border-2 border-stone-800 rounded-3xl p-6 flex flex-col justify-between shadow-2xl ticket-card" id="card-<%= order.id %>" data-created-ms="<%= order.prepStartedAt || order.createdAtMs || Date.now() %>" data-prep-started="<%= order.status === 'In Progress' ? 'false' : 'true' %>" data-prep-minutes="<%= order.promisedMinutes || order.aiPrepMinutes || 20 %>">
                    <div>
                        <!-- Order ID & Fixed Countdown Badge -->
                        <div class="flex justify-between items-start mb-5 pb-3 border-b border-stone-800">
                            <div>
                                <span class="text-[10px] font-mono text-stone-500 block uppercase">Ticket ID</span>
                                <span class="font-mono font-black text-amber-400 text-2xl"><%= order.id %></span>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] font-black px-3 py-1 rounded-full bg-stone-800 text-stone-200 uppercase tracking-widest block mb-1 status-label">
                                    <%= order.status %>
                                </span>
                                <span class="font-mono text-sm text-emerald-400 font-extrabold timer-badge">
                                    <%= order.status === 'In Progress' ? 'Awaiting prep' : '⏱️ 45:00' %>
                                </span>
                                <span class="block text-[10px] text-stone-400 mt-1">AI prep: <%= order.aiPrepMinutes || 20 %> min</span>
                            </div>
                        </div>

                        <!-- Items List -->
                        <ul class="space-y-3 mb-6">
                            <% order.items.forEach(i => { %>
                                <li class="flex items-start text-stone-100 border-b border-stone-800/80 pb-2.5">
                                    <span class="text-amber-400 font-black text-2xl font-mono mr-3 leading-none"><%= i.qty %>x</span>
                                    <span class="font-bold text-lg tracking-tight leading-snug"><%= i.name %></span>
                                </li>
                            <% }) %>
                        </ul>
                    </div>

                    <!-- Stage Controls (Forward-Only Guards) -->
                    <div class="space-y-2.5 pt-3 border-t border-stone-800">
                        <div class="grid grid-cols-2 gap-2">
                            <% const hasStartedPrep = order.status !== 'In Progress'; %>
                            <% const isPastPrep = order.status === 'Ready for pickup' || order.status === 'Rider Handoff'; %>
                            <button 
                                onclick="updateStatus('<%= order.id %>', 'Preparing')" 
                                <%= hasStartedPrep ? 'disabled' : '' %>
                                class="py-3 rounded-xl font-black text-xs uppercase tracking-wider transition <%= order.status === 'Preparing' ? 'bg-amber-600 text-white shadow-lg' : 'bg-stone-800 text-stone-400' %> <%= hasStartedPrep ? 'opacity-30 cursor-not-allowed' : 'hover:bg-amber-600 hover:text-white cursor-pointer' %>">
                                <%= order.status === 'Preparing' ? 'Preparing' : 'Start Prep' %>
                            </button>

                            <% const isPastReady = order.status === 'Rider Handoff'; %>
                            <% const canMarkReady = order.status === 'Preparing'; %>
                            <button 
                                onclick="updateStatus('<%= order.id %>', 'Ready for pickup')" 
                                <%= !canMarkReady && order.status !== 'Ready for pickup' ? 'disabled' : '' %>
                                class="py-3 rounded-xl font-black text-xs uppercase tracking-wider transition <%= order.status === 'Ready for pickup' ? 'bg-emerald-600 text-white shadow-lg' : 'bg-stone-800 text-stone-400' %> <%= !canMarkReady && order.status !== 'Ready for pickup' ? 'opacity-30 cursor-not-allowed' : 'hover:bg-emerald-600 hover:text-white cursor-pointer' %>">
                                Ready
                            </button>
                        </div>

                        <button 
                            onclick="updateStatus('<%= order.id %>', 'Rider Handoff')" 
                            <%= order.status !== 'Ready for pickup' ? 'disabled' : '' %>
                            class="w-full py-3.5 rounded-xl font-black text-xs uppercase tracking-wider transition bg-blue-600 hover:bg-blue-700 text-white shadow-lg <%= order.status !== 'Ready for pickup' ? 'opacity-30 cursor-not-allowed' : 'cursor-pointer' %>">
                            Rider Handoff (Complete)
                        </button>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <script>
        const socket = io();

        function updateStatus(orderId, status) {
            socket.emit('update-order-status', { orderId, status });
        }

        socket.on('order-updated', (order) => {
            if (order.outletId === '<%= outlet.id %>') window.location.reload();
        });
        socket.on('new-order-received', (order) => {
            if (order.outletId === '<%= outlet.id %>') {
                window.location.reload();
            }
        });

        // Continuous 45-Minute Timer Calculation based on Fixed Creation Time
        function updateTimers() {
            const now = Date.now();

            document.querySelectorAll('.ticket-card').forEach(card => {
                if (card.getAttribute('data-prep-started') !== 'true') {
                    card.querySelector('.timer-badge').innerText = 'Awaiting prep';
                    return;
                }
                const createdMs = parseInt(card.getAttribute('data-created-ms'), 10);
                const SLA_SECONDS = (parseInt(card.getAttribute('data-prep-minutes'), 10) || 20) * 60;
                const elapsedSecs = Math.floor((now - createdMs) / 1000);
                const remainingSecs = SLA_SECONDS - elapsedSecs;

                const badge = card.querySelector('.timer-badge');
                const statusLabel = card.querySelector('.status-label');

                if (remainingSecs > 0) {
                    const mins = Math.floor(remainingSecs / 60).toString().padStart(2, '0');
                    const secs = (remainingSecs % 60).toString().padStart(2, '0');
                    badge.innerText = `⏱️ ${mins}:${secs}`;
                } else {
                    badge.innerText = `⏱️ OVERDUE`;
                }

                // Apply persistent highlight thresholds:
                // Remaining <= 15 Mins (Elapsed >= 30 Mins) -> Red Text & Border
                // Remaining <= 5 Mins -> Pulse/Zoom Animation
                if (remainingSecs <= 900 && remainingSecs > 300) {
                    card.className = "bg-stone-900 border-2 border-red-600 bg-red-950/30 rounded-3xl p-6 flex flex-col justify-between shadow-2xl ticket-card";
                    badge.className = "font-mono text-sm text-red-400 font-extrabold timer-badge";
                    statusLabel.className = "text-[10px] font-black px-3 py-1 rounded-full bg-red-600 text-white uppercase tracking-widest block mb-1 status-label";
                } else if (remainingSecs <= 300) {
                    card.className = "bg-stone-900 border-2 border-red-600 bg-red-950/60 rounded-3xl p-6 flex flex-col justify-between shadow-2xl ticket-card animate-zoom";
                    badge.className = "font-mono text-sm text-red-500 font-black timer-badge";
                    statusLabel.className = "text-[10px] font-black px-3 py-1 rounded-full bg-red-700 text-white uppercase tracking-widest block mb-1 status-label";
                }
            });
        }

        setInterval(updateTimers, 1000);
        updateTimers();
    </script>
</body>
</html>
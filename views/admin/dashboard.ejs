<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manager Operations Dashboard - Company A</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="/socket.io/socket.io.js"></script>
</head>
<body class="bg-stone-100 text-stone-900 font-sans">
    <%- include('../partials/nav') %>

    <main class="max-w-7xl mx-auto px-4 py-8">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-extrabold tracking-tight">Central Operations Dashboard</h1>
                <p class="text-xs text-stone-500 mt-1">Real-Time Outlet Monitoring & Catering Approvals</p>
            </div>
            <a href="/admin/cms" class="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow">
                Manage Menu CMS
            </a>
        </div>

        <!-- Outlet Overview Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <% outlets.forEach(o => { %>
                <% const count = activeOrders.filter(ord => ord.outletId === o.id).length; %>
                <div class="bg-white border border-stone-200 rounded-2xl p-5 shadow-sm">
                    <h3 class="font-bold text-lg text-stone-800"><%= o.name %></h3>
                    <p class="text-xs text-stone-400 font-mono mb-3">FSSAI: <%= o.fssai %></p>
                    <div class="flex justify-between items-center border-t border-stone-100 pt-3">
                        <span class="text-xs text-stone-600">Active Live Orders</span>
                        <span class="font-extrabold text-amber-600 text-lg"><%= count %></span>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Catering & Bulk Party Orders Approval Section -->
        <section class="mb-8 bg-white border border-stone-200 rounded-2xl p-6 shadow-sm">
            <h2 class="text-xl font-bold mb-1">Catering & Party Orders (Manager Approvals)</h2>
            <p class="text-xs text-stone-500 mb-4">Requests requiring a minimum 48h notice period for catering prep.</p>

            <% if (!partyOrders || partyOrders.length === 0) { %>
                <div class="bg-stone-50 border border-stone-200 rounded-xl p-8 text-center text-stone-400 text-sm">
                    No bulk party catering requests submitted yet.
                </div>
            <% } else { %>
                <div class="space-y-4">
                    <% partyOrders.forEach(p => { %>
                        <div class="border border-stone-200 rounded-xl p-4 flex justify-between items-center bg-stone-50 hover:border-amber-400 transition">
                            <div>
                                <div class="flex items-center gap-3 mb-1">
                                    <span class="font-bold text-amber-600 text-sm"><%= p.id %></span>
                                    <span class="text-xs font-bold px-2 py-0.5 rounded <%= p.status.includes('Confirmed') ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' %>">
                                        <%= p.status %>
                                    </span>
                                </div>
                                <p class="text-xs text-stone-700 font-semibold"><%= p.customerName %> (<%= p.phone %>) • <%= p.guests %> Guests</p>
                                <p class="text-xs text-stone-500 mt-0.5">Outlet: <span class="font-bold uppercase"><%= p.outletId %></span> | Scheduled: <%= new Date(p.deliveryDate).toLocaleString() %></p>
                                <p class="text-xs text-stone-500 italic mt-1 bg-white border border-stone-200 p-2 rounded">"<%= p.details %>"</p>
                            </div>

                            <div class="ml-4 flex flex-col items-end gap-2">
                                <% if (p.status === 'Pending Manager Confirmation') { %>
                                    <form action="/admin/confirm-party-order" method="POST">
                                        <input type="hidden" name="partyOrderId" value="<%= p.id %>">
                                        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow transition cursor-pointer">
                                            Confirm Party Order
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-xs text-green-700 font-bold bg-green-100 px-3 py-1.5 rounded-full border border-green-200">
                                        Confirmed ✓
                                    </span>
                                <% } %>
                                <form action="/admin/delete-party-order" method="POST" onsubmit="return confirm('Delete party order <%= p.id %>? This cannot be undone.');">
                                    <input type="hidden" name="partyOrderId" value="<%= p.id %>">
                                    <button type="submit" class="bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs px-4 py-2 rounded-xl shadow transition cursor-pointer">
                                        Delete Order
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </section>

        <section class="mb-8 bg-white border border-stone-200 rounded-2xl p-6 shadow-sm">
            <h2 class="text-xl font-bold mb-4">Estimated Promise Overrides</h2>
            <div class="space-y-4">
                <% if (!estimatedOrders || estimatedOrders.length === 0) { %>
                    <p class="text-sm text-stone-400">No active orders need promise overrides yet.</p>
                <% } else { %>
                    <% estimatedOrders.forEach(ord => { %>
                        <div class="border border-stone-200 rounded-xl p-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                            <div>
                                <div class="font-mono font-bold text-amber-600 text-sm"><%= ord.id %></div>
                                <div class="text-xs text-stone-500 mt-1">Current promise: <%= ord.promisedAt ? new Date(ord.promisedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Pending' %></div>
                            </div>
                            <form action="/admin/override-estimate" method="POST" class="flex items-center gap-2">
                                <input type="hidden" name="orderId" value="<%= ord.id %>">
                                <input type="number" name="minutes" min="10" value="<%= ord.promisedMinutes || 20 %>" class="w-24 border border-stone-200 rounded-lg px-3 py-2 text-xs font-bold text-stone-800">
                                <button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs px-4 py-2 rounded-xl shadow transition">
                                    Override
                                </button>
                            </form>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </section>

        <!-- Live Orders Overview Board -->
        <section class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm">
            <h2 class="text-xl font-bold mb-4">All Outlet Active Orders</h2>

            <% if (activeOrders.length === 0) { %>
                <p class="text-sm text-stone-400">No active customer orders across any outlet.</p>
            <% } else { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-stone-200 text-xs text-stone-500 uppercase">
                                <th class="py-3 px-2">Order ID</th>
                                <th class="py-3 px-2">Outlet</th>
                                <th class="py-3 px-2">Items</th>
                                <th class="py-3 px-2">Total</th>
                                <th class="py-3 px-2">Status</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm">
                            <% activeOrders.forEach(ord => { %>
                                <tr class="border-b border-stone-100 hover:bg-stone-50">
                                    <td class="py-3 px-2 font-mono font-bold text-amber-600"><%= ord.id %></td>
                                    <td class="py-3 px-2 capitalize font-semibold"><%= ord.outletId %></td>
                                    <td class="py-3 px-2">
                                        <% ord.items.forEach(i => { %>
                                            <span class="block text-xs"><%= i.qty %>x <%= i.name %></span>
                                        <% }) %>
                                    </td>
                                    <td class="py-3 px-2 font-bold">₹<%= ord.total %></td>
                                    <td class="py-3 px-2">
                                        <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-stone-200 text-stone-800">
                                            <%= ord.status %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </main>

    <!-- Real-time WebSockets Live Updates -->
    <script>
        const socket = io();
        socket.on('new-order-received', () => window.location.reload());
        socket.on('order-updated', () => window.location.reload());
        socket.on('party-order-submitted', () => window.location.reload());
        socket.on('party-order-updated', () => window.location.reload());
        socket.on('party-order-deleted', () => window.location.reload());
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Order Status - <%= order.id %></title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-stone-50 text-stone-900 font-sans">
    <%- include('../partials/nav') %>

    <main class="max-w-xl mx-auto bg-white rounded-2xl shadow-sm border border-stone-200 p-8 my-10">
        <div class="flex justify-between items-center mb-6 border-b pb-4">
            <div>
                <h1 class="text-2xl font-bold">Live Order Tracking</h1>
                <span class="font-mono text-amber-600 font-bold text-sm"><%= order.id %></span>
            </div>
            <span id="order-status" class="bg-amber-100 text-amber-800 px-3 py-1 rounded-full text-xs font-bold uppercase"><%= order.status %></span>
        </div>

        <div class="space-y-6 mb-8">
            <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-green-600 text-white flex items-center justify-center font-bold text-sm">✓</div>
                <div>
                    <h4 class="font-bold text-sm"><%= order.paymentStatus === 'Paid' || order.paymentStatus === 'Test payment approved' ? 'Order Confirmed & Routed' : 'Waiting for PhonePe payment' %></h4>
                    <p class="text-xs text-stone-500"><%= order.paymentStatus === 'Paid' || order.paymentStatus === 'Test payment approved' ? `Sent straight to ${order.outletId || 'outlet'} kitchen screen` : `Payment status: ${order.paymentStatus}. The kitchen receives your order after payment is confirmed.` %></p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-amber-600 text-white flex items-center justify-center font-bold text-sm animate-pulse">⏳</div>
                <div>
                    <h4 id="prep-heading" class="font-bold text-sm"><%= order.status === 'In Progress' ? 'Order in progress — awaiting kitchen prep' : `Kitchen Prep (AI Estimated: ${order.aiPrepMinutes || 20} mins)` %></h4>
                    <p class="text-xs text-stone-500">Promised ready by <strong><%= order.promisedAt ? new Date(order.promisedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'calculating...' %></strong></p>
                </div>
            </div>
            <div class="rounded-xl bg-stone-50 border border-stone-200 p-4 text-xs text-stone-600">
                <div class="flex justify-between"><span>AI estimate</span><span class="font-bold text-stone-900"><%= order.aiPrepMinutes || 20 %> mins</span></div>
                <div class="flex justify-between mt-2"><span>Outlet minimum</span><span class="font-bold text-stone-900"><%= order.promisedMinutes && order.promisedMinutes > (order.aiPrepMinutes || 20) ? order.promisedMinutes - (order.aiPrepMinutes || 20) : 0 %> mins</span></div>
                <div class="flex justify-between mt-2"><span>Promised time</span><span class="font-bold text-amber-700"><%= order.promisedAt ? new Date(order.promisedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Pending' %></span></div>
            </div>
        </div>

        <% if (order.paymentStatus === 'Failed' || order.paymentStatus === 'Initiation Failed') { %>
            <div class="mb-6 rounded-xl bg-rose-50 border border-rose-200 p-4 text-sm text-rose-800">
                PhonePe did not complete this payment. Your cart was kept so you can return to checkout and try again.
            </div>
            <a href="/cart" class="block text-center bg-rose-600 hover:bg-rose-700 text-white font-bold py-3 rounded-xl text-sm transition mb-3">Return to Checkout</a>
        <% } else if (order.paymentStatus === 'Pending') { %>
            <div class="mb-6 rounded-xl bg-amber-50 border border-amber-200 p-4 text-sm text-amber-800">
                Payment is not confirmed yet. Refresh this page after completing checkout in PhonePe.
            </div>
        <% } %>

        <a href="/" class="block text-center bg-stone-900 hover:bg-stone-800 text-white font-bold py-3 rounded-xl text-sm transition">
            Back to Menu
        </a>
    </main>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        socket.on('order-updated', (updatedOrder) => {
            if (updatedOrder.id === '<%= order.id %>') {
                document.getElementById('order-status').innerText = updatedOrder.status;
                document.getElementById('prep-heading').innerText = updatedOrder.status === 'In Progress'
                    ? 'Order in progress — awaiting kitchen prep'
                    : `Kitchen Prep (AI Estimated: ${updatedOrder.aiPrepMinutes || 20} mins)`;
            }
        });
    </script>
</body>
</html>
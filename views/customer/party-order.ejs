<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Party & Bulk Orders - Company A</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-stone-50 text-stone-900 font-sans">
    <%- include('../partials/nav') %>

    <main class="max-w-2xl mx-auto bg-white rounded-2xl shadow-sm border border-stone-200 p-8 my-10">
        <h1 class="text-2xl font-bold mb-2">Bulk & Party Order Request</h1>
        <p class="text-sm text-stone-500 mb-6">Hosting a gathering? Order authentic Hyderabadi biryani feasts with minimum 4 hours notice. Confirmed by our catering manager.</p>

        <form action="/submit-party-order" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-stone-700 uppercase mb-1">Full Name</label>
                <input type="text" name="name" required class="w-full border rounded-lg p-3 text-sm focus:ring-2 focus:ring-amber-600 outline-none">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-stone-700 uppercase mb-1">Phone Number</label>
                    <input type="tel" name="phone" required class="w-full border rounded-lg p-3 text-sm focus:ring-2 focus:ring-amber-600 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-stone-700 uppercase mb-1">Guest Count</label>
                    <input type="number" name="guests" min="10" placeholder="Min 15 people" required class="w-full border rounded-lg p-3 text-sm focus:ring-2 focus:ring-amber-600 outline-none">
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-stone-700 uppercase mb-1">Event Date & Time (Min 4 hrs notice)</label>
                <input type="datetime-local" name="event_time" required class="w-full border rounded-lg p-3 text-sm focus:ring-2 focus:ring-amber-600 outline-none">
            </div>
            <div>
                <label class="block text-xs font-bold text-stone-700 uppercase mb-1">Special Requirements</label>
                <textarea name="notes" rows="3" placeholder="e.g. 5 Chicken Dum Biryani Family Packs" class="w-full border rounded-lg p-3 text-sm focus:ring-2 focus:ring-amber-600 outline-none"></textarea>
            </div>
            <button type="submit" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-3.5 rounded-xl transition shadow-md">
                Request Catering Quotation
            </button>
        </form>
    </main>
</body>
</html>
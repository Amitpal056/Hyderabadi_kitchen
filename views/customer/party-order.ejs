<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Party & Bulk Catering Orders - Company A</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-stone-50 text-stone-900 font-sans">
    <%- include('../partials/nav') %>

    <main class="max-w-2xl mx-auto px-4 py-10">
        <h1 class="text-3xl font-extrabold mb-2">Bulk Biryani & Catering Requests</h1>
        <p class="text-sm font-bold mb-6 text-red-900">Planning an event or corporate lunch? Requests require a **minimum of 48 hours notice** for catering prep and manager approval.</p>

        <form action="/submit-party-order" method="POST" class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 space-y-4">
            <div>
                <label class="block text-xs font-bold uppercase text-stone-600 mb-1">Your Full Name</label>
                <input type="text" name="name" required class="w-full border rounded-lg p-2.5 text-sm bg-stone-50 outline-none focus:border-amber-500">
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-stone-600 mb-1">Phone Number</label>
                    <input type="tel" name="phone" required class="w-full border rounded-lg p-2.5 text-sm bg-stone-50 outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-stone-600 mb-1">Expected Guests</label>
                    <input type="number" name="guests" min="15" value="25" required class="w-full border rounded-lg p-2.5 text-sm bg-stone-50 outline-none focus:border-amber-500">
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase text-stone-600 mb-1">Fulfillment Outlet Location</label>
                <select name="outletId" class="w-full border rounded-lg p-2.5 text-sm bg-stone-50 outline-none focus:border-amber-500">
                    <% outlets.forEach(o => { %>
                        <option value="<%= o.id %>"><%= o.name %></option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase text-stone-600 mb-1">Requested Delivery Date & Time (Min 48h Notice)</label>
                <input type="datetime-local" id="deliveryDate" name="deliveryDate" required class="w-full border rounded-lg p-2.5 text-sm bg-stone-50 outline-none focus:border-amber-500">
            </div>

            <div>
                <label class="block text-xs font-bold uppercase text-stone-600 mb-1">Specific Catering Details & Menu Customization</label>
                <textarea name="details" rows="3" placeholder="e.g. 10kg Chicken Biryani, 5kg Double ka Meetha, extra Salan bowls" class="w-full border rounded-lg p-2.5 text-sm bg-stone-50 outline-none focus:border-amber-500"></textarea>
            </div>

            <button type="submit" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 rounded-xl transition text-sm shadow cursor-pointer">
                Submit Request for Manager Review
            </button>
        </form>
    </main>

    <script>
        // Set min date picker attribute to exactly 48 hours from current moment
        const minDate = new Date(Date.now() + 48 * 60 * 60 * 1000);
        const isoMin = minDate.toISOString().slice(0, 16);
        document.getElementById('deliveryDate').min = isoMin;
        document.getElementById('deliveryDate').value = isoMin;
    </script>
</body>
</html>
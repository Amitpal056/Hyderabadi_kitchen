<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders - Hyderabadi Biryani Direct</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="/socket.io/socket.io.js"></script>
</head>
<body class="bg-stone-50 text-stone-900 font-sans antialiased min-h-screen">
    <%- include('../partials/nav') %>

    <main class="max-w-4xl mx-auto px-6 py-12">
        <div class="flex justify-between items-center pb-6 mb-8 border-b border-stone-200">
            <div>
                <h1 class="text-3xl font-extrabold tracking-tight">Recent Orders History</h1>
                <p class="text-xs text-stone-500 mt-1">View past orders, item details, and status updates</p>
            </div>
            <a href="/" class="bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs uppercase px-4 py-2.5 rounded-xl transition shadow-xs">
                + Order More
            </a>
        </div>

        <% if (!orders || orders.length === 0) { %>
            <div class="bg-white rounded-2xl border border-stone-200 p-12 text-center text-stone-500">
                <div class="text-4xl mb-3">📦</div>
                <h2 class="text-lg font-bold text-stone-800 mb-1">No orders placed yet</h2>
                <p class="text-xs text-stone-500 mb-6">Select your nearest outlet and place your first feast!</p>
                <a href="/" class="inline-block bg-stone-900 text-white font-bold text-xs uppercase px-5 py-3 rounded-xl hover:bg-amber-600 transition">
                    Browse Menu
                </a>
            </div>
        <% } else { %>
            <div class="space-y-6">
                <% orders.forEach(ord => { %>
                    <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-xs flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div class="space-y-3 flex-1">
                            <div class="flex items-center gap-3">
                                <span class="font-mono font-bold text-amber-700 text-sm"><%= ord.id %></span>
                                <span class="text-[10px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider border <%= ord.status === 'Rider Handoff' ? 'bg-blue-100 text-blue-800 border-blue-200' : 'bg-emerald-100 text-emerald-800 border-emerald-200' %>">
                                    <%= ord.status %>
                                </span>
                            </div>

                            <!-- Ordered Items Breakdown -->
                            <div class="bg-stone-50 border border-stone-100 rounded-xl p-3 space-y-1 text-xs">
                                <% ord.items.forEach(item => { %>
                                    <div class="flex justify-between font-medium">
                                        <span class="text-stone-800"><strong class="font-mono text-amber-700"><%= item.qty %>x</strong> <%= item.name %></span>
                                    </div>
                                <% }) %>
                            </div>

                            <div class="flex flex-wrap items-center gap-4 text-xs text-stone-500 font-medium">
                                <span>Outlet: <strong class="text-stone-800 uppercase"><%= ord.outletId %></strong></span>
                                <span>•</span>
                                <span>Payment: <strong class="text-stone-800"><%= ord.payment %></strong></span>
                                <span>•</span>
                                <span>Time: <strong class="text-stone-800"><%= ord.createdAt %></strong></span>
                            </div>
                        </div>

                        <div class="text-right border-t md:border-t-0 md:border-l border-stone-200 pt-3 md:pt-0 md:pl-6 w-full md:w-auto flex md:flex-col justify-between items-center md:items-end">
                            <span class="text-xs text-stone-400 block font-medium">Total Paid</span>
                            <span class="font-extrabold text-xl text-stone-900">₹<%= ord.total %></span>
                            <a href="/order/<%= ord.id %>" class="mt-2 text-xs font-bold text-amber-700 hover:text-amber-800 underline block">
                                Track Order →
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <script>
        const socket = io();
        socket.on('order-updated', () => window.location.reload());
    </script>
</body>
</html>
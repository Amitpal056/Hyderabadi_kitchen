<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Party Orders - Hyderabadi Biryani Direct</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="/socket.io/socket.io.js"></script>
</head>
<body class="bg-stone-50 text-stone-900 font-sans antialiased min-h-screen">
    <%- include('../partials/nav') %>

    <main class="max-w-4xl mx-auto px-6 py-12">
        <div class="flex justify-between items-center pb-6 mb-8 border-b border-stone-200">
            <div>
                <h1 class="text-3xl font-extrabold tracking-tight">Booked Party & Catering History</h1>
                <p class="text-xs text-stone-500 mt-1">Track the live approval status of your bulk biryani requests</p>
            </div>
            <a href="/party-order" class="bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs uppercase px-4 py-2.5 rounded-xl transition shadow-xs">
                + New Party Request
            </a>
        </div>

        <% if (!partyOrders || partyOrders.length === 0) { %>
            <div class="bg-white rounded-2xl border border-stone-200 p-12 text-center text-stone-500">
                <div class="text-4xl mb-3">🎉</div>
                <h2 class="text-lg font-bold text-stone-800 mb-1">No party orders booked yet</h2>
                <p class="text-xs text-stone-500 mb-6">Planning an event or corporate lunch? Book minimum 48 hours in advance.</p>
                <a href="/party-order" class="inline-block bg-stone-900 text-white font-bold text-xs uppercase px-5 py-3 rounded-xl hover:bg-amber-600 transition">
                    Submit Catering Request
                </a>
            </div>
        <% } else { %>
            <div class="space-y-6">
                <% partyOrders.forEach(p => { %>
                    <div class="bg-white rounded-2xl border border-stone-200 p-6 shadow-xs flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div class="space-y-2 flex-1">
                            <div class="flex items-center gap-3">
                                <span class="font-mono font-bold text-amber-700 text-sm"><%= p.id %></span>
                                <% if (p.status.includes('Confirmed')) { %>
                                    <span class="bg-emerald-100 text-emerald-800 text-[10px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider border border-emerald-200">
                                        ✓ Approved by Manager
                                    </span>
                                <% } else { %>
                                    <span class="bg-amber-100 text-amber-900 text-[10px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider border border-amber-200 animate-pulse">
                                        ⏳ Pending Confirmation
                                    </span>
                                <% } %>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-2 text-xs text-stone-600">
                                <div>
                                    <span class="block text-[10px] font-bold text-stone-400 uppercase">Guests</span>
                                    <span class="font-bold text-stone-900"><%= p.guests %> People</span>
                                </div>
                                <div>
                                    <span class="block text-[10px] font-bold text-stone-400 uppercase">Scheduled Delivery</span>
                                    <span class="font-bold text-stone-900"><%= new Date(p.deliveryDate).toLocaleString() %></span>
                                </div>
                                <div>
                                    <span class="block text-[10px] font-bold text-stone-400 uppercase">Fulfillment Outlet</span>
                                    <span class="font-bold text-stone-900 uppercase"><%= p.outletId %></span>
                                </div>
                            </div>

                            <div class="bg-stone-50 border border-stone-100 p-3 rounded-xl text-xs text-stone-600 italic">
                                "<%= p.details %>"
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <script>
        const socket = io();
        socket.on('party-order-updated', () => window.location.reload());
        socket.on('party-order-deleted', (order) => {
            if (order.email === '<%= user.email %>') window.location.reload();
        });
    </script>
</body>
</html>
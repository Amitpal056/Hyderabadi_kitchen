<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Checkout - Company A Biryani</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-stone-50 text-stone-900 font-sans">
    <%- include('../partials/nav') %>

    <main class="max-w-3xl mx-auto px-4 py-10">
        <h1 class="text-2xl font-bold mb-6">Review Cart & Secure Checkout</h1>
        
        <% if (cart.length === 0) { %>
            <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-12 text-center">
                <div class="text-4xl mb-3">🛒</div>
                <h2 class="text-xl font-bold mb-2">Your cart is empty</h2>
                <p class="text-sm text-stone-500 mb-6">Pick an outlet and add your favorite biryani feast.</p>
                <a href="/" class="inline-block bg-amber-600 hover:bg-amber-700 text-white font-bold px-6 py-3 rounded-xl text-sm transition">
                    Browse Menu
                </a>
            </div>
        <% } else { %>
            <form action="/place-order" method="POST" class="space-y-6">
                <input type="hidden" name="redeemed" id="redeemed-input" value="false">
                <input type="hidden" name="coupon" id="coupon-input" value="">
                
                <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
                    <h2 class="font-semibold text-lg mb-4 border-b pb-2">Cart Items (<%= currentOutlet.name %>)</h2>
                    <div class="space-y-4 mb-6">
                        <% cart.forEach(item => { %>
                            <div class="flex justify-between items-center text-sm border-b border-stone-100 pb-3">
                                <div>
                                    <h4 class="font-bold"><%= item.name %></h4>
                                    <span class="text-xs text-stone-500">Portion: <%= item.portion %> | Add-on: <%= item.addon %></span>
                                </div>
                                <div class="flex items-center gap-4">
                                    <div class="flex items-center border rounded-lg bg-stone-50 overflow-hidden">
                                        <a href="/cart/decrease/<%= item.cartKey %>" class="px-2.5 py-1 bg-stone-200 hover:bg-stone-300 font-bold text-stone-700 transition">-</a>
                                        <span class="px-3 font-bold text-xs"><%= item.qty %></span>
                                        <a href="/cart/increase/<%= encodeURIComponent(item.cartKey) %>" class="px-2.5 py-1 bg-stone-200 hover:bg-stone-300 font-bold text-stone-700 transition">+</a>
                                    </div>
                                    <span class="font-semibold w-16 text-right">₹<%= item.price * item.qty %></span>
                                    <a href="/cart/remove/<%= item.cartKey %>" class="text-red-600 hover:text-red-800 text-xs font-bold px-2 py-1 bg-red-50 rounded transition">
                                        Remove
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <!-- Coupon Code Input Box -->
                    <div class="mb-6 bg-stone-50 border border-stone-200 p-4 rounded-xl flex gap-2">
                        <input type="text" id="coupon-code" placeholder="Enter Coupon (e.g. HYDRA100)" class="flex-1 border rounded-lg px-3 py-2 text-xs uppercase outline-none bg-white font-mono">
                        <button type="button" onclick="applyCoupon()" class="bg-stone-900 text-white px-4 py-2 rounded-lg text-xs font-bold hover:bg-stone-800 transition cursor-pointer">Apply Coupon</button>
                    </div>
                    <p id="coupon-msg" class="text-xs text-green-700 font-semibold mb-4 hidden"></p>

                    <!-- Loyalty Rewards Section -->
                    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6 flex justify-between items-center">
                        <div>
                            <p class="font-bold text-amber-900 text-sm">Loyalty Rewards</p>
                            <p class="text-xs text-amber-700">You have 240 points available (Worth ₹24)</p>
                        </div>
                        <button type="button" id="redeem-btn" onclick="redeemPoints()" class="bg-amber-600 hover:bg-amber-700 text-white px-3 py-1.5 rounded text-xs font-semibold transition cursor-pointer">
                            Redeem
                        </button>
                    </div>

                    <!-- Bill Breakdown -->
                    <div class="border-t border-stone-200 pt-4 space-y-2 text-sm">
                        <div class="flex justify-between"><span class="text-stone-600">Item Total</span><span>₹<%= itemTotal %></span></div>
                        <div class="flex justify-between"><span class="text-stone-600">Delivery Fee</span><span>₹56</span></div>
                        <div id="discount-row" class="flex justify-between text-green-700 font-medium hidden">
                            <span>Discount Applied</span>
                            <span id="discount-val">-₹24</span>
                        </div>
                        <div class="flex justify-between text-xs text-stone-400"><span>Includes 5% GST</span><span>Calculated at checkout</span></div>
                        <div class="flex justify-between font-extrabold text-base pt-2 border-t border-stone-200">
                            <span>To Pay</span>
                            <span id="final-total">₹<%= itemTotal + 56 %></span>
                        </div>
                    </div>
                </div>

                <!-- Order notification preferences -->
                <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6">
                    <h2 class="font-semibold text-lg mb-2">Order updates by SMS</h2>
                    <p class="text-xs text-stone-500 mb-4">Your order will be sent to <strong><%= currentOutlet.name %></strong>. Enter an Indian mobile number.</p>
                    <% if (smsConfigured) { %>
                        <p class="text-xs text-emerald-700 mb-4">SMS status updates are available when you opt in.</p>
                    <% } else { %>
                        <p class="text-xs text-amber-700 mb-4">SMS delivery is not configured yet. Orders work normally; messages will be enabled after Twilio SMS setup.</p>
                    <% } %>
                    <label class="block text-xs font-bold uppercase text-stone-600 mb-1" for="phone">Mobile number for SMS (optional)</label>
                    <div class="flex items-center border rounded-lg bg-stone-50 mb-4">
                        <span class="px-3 py-2.5 text-sm text-stone-500 border-r">+91</span>
                        <input id="phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" pattern="[6-9][0-9]{9}" value="<%= customerPhone.replace(/\D/g, '').replace(/^91/, '') %>" placeholder="9876543210" <%= customerSmsOptIn ? 'required' : '' %> class="flex-1 bg-transparent px-3 py-2.5 text-sm outline-none">
                    </div>
                    <label class="flex items-start gap-2 text-xs text-stone-600 mb-6">
                        <input id="sms-opt-in" type="checkbox" name="smsOptIn" value="yes" <%= customerSmsOptIn ? 'checked' : '' %> class="mt-0.5">
                        <span>I agree to receive SMS text messages about this order, including confirmation, preparation status, and delays. Message and data rates may apply.</span>
                    </label>

                    <h2 class="font-semibold text-lg mb-2">Payment with PhonePe</h2>
                    <p class="text-xs text-stone-500">Continue to PhonePe’s secure checkout to pay by UPI, card, or other enabled methods.</p>
                    <% if (phonePeConfigured) { %>
                        <p class="text-xs text-emerald-700 mt-2">PhonePe <%= phonePeEnvironment === 'production' ? 'production' : 'sandbox' %> checkout is configured.</p>
                    <% } else { %>
                        <p class="text-xs text-amber-700 mt-2">PhonePe is not configured. Add PHONEPAY_CLIENT_ID and PHONEPAY_CLIENT_SECRET to the server’s .env file.</p>
                    <% } %>
                </div>

                <button type="submit" id="pay-btn" <%= phonePeConfigured ? '' : 'disabled' %> class="w-full bg-amber-600 hover:bg-amber-700 disabled:bg-stone-400 disabled:cursor-not-allowed text-white text-center py-3.5 rounded-xl font-bold shadow-md transition cursor-pointer">
                    <%= phonePeConfigured ? `Continue to PhonePe (₹${itemTotal + 56})` : 'PhonePe checkout unavailable' %>
                </button>
            </form>
        <% } %>
    </main>

    <script>
        const smsOptInInput = document.getElementById('sms-opt-in');
        const phoneInput = document.getElementById('phone');
        smsOptInInput.addEventListener('change', () => {
            phoneInput.required = smsOptInInput.checked;
        });

        let baseTotal = <%= cart.length > 0 ? itemTotal + 56 : 0 %>;
        let discountTotal = 0;
        let isRedeemed = false;

        function redeemPoints() {
            if (!isRedeemed) {
                isRedeemed = true;
                discountTotal += 24;
                baseTotal -= 24;
                updateTotals();
                document.getElementById('redeemed-input').value = 'true';
                
                const btn = document.getElementById('redeem-btn');
                btn.innerText = 'Applied (₹24 off)';
                btn.classList.replace('bg-amber-600', 'bg-green-700');
            }
        }

        function applyCoupon() {
            const code = document.getElementById('coupon-code').value.trim().toUpperCase();
            const msg = document.getElementById('coupon-msg');
            if (code === 'HYDRA100') {
                discountTotal += 100;
                baseTotal -= 100;
                updateTotals();
                document.getElementById('coupon-input').value = 'HYDRA100';
                msg.innerText = 'Coupon HYDRA100 applied successfully (-₹100)';
                msg.classList.remove('hidden');
            } else {
                alert('Invalid Coupon Code. Try HYDRA100');
            }
        }

        function updateTotals() {
            document.getElementById('final-total').innerText = `₹${Math.max(0, baseTotal)}`;
            document.getElementById('discount-val').innerText = `-₹${discountTotal}`;
            document.getElementById('discount-row').classList.remove('hidden');
            document.getElementById('pay-btn').innerText = `Continue to PhonePe (₹${Math.max(0, baseTotal)})`;
        }
    </script>
</body>
</html>
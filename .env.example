PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/hydrabadi_kitchen
SESSION_SECRET=

# PhonePe Payment Gateway. Sandbox is the safe default.
PHONEPAY_CLIENT_ID=
PHONEPAY_CLIENT_SECRET=
PHONEPAY_CLIENT_VERSION=1
PHONEPAY_ENV=sandbox
APP_BASE_URL=http://localhost:3000

# Copy Twilio credentials into your ignored local .env. Never commit credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use an SMS-enabled Twilio phone number, such as +15551234567.
TWILIO_SMS_FROM=
